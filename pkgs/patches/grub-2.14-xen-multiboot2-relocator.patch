diff -ru a/grub-core/lib/i386/relocator_common_c.c b/grub-core/lib/i386/relocator_common_c.c
--- a/grub-core/lib/i386/relocator_common_c.c	2026-09-10 03:16:23.977749581 -0400
+++ b/grub-core/lib/i386/relocator_common_c.c	2026-09-10 03:16:49.154545031 -0400
@@ -109,6 +109,7 @@
   grub_uint64_t *pt2 = pt3 + (npt3pages << PAGE_IDX_SIZE);
   grub_uint64_t *endpreamble = pt2 + (npt2pages << PAGE_IDX_SIZE);
   grub_uint64_t i;
+  grub_uint64_t firmware_cr3;
 
   /* movabs $pt4, %rax.  */
   *p++ = 0x48;
@@ -123,6 +124,11 @@
 
   /* jmp $endpreamble.  */
   *p++ = 0xe9;
+
+  /* Inherit firmware PML4 so high mappings (EFI runtime, MMIO) */
+  /* remain reachable after switching to our own page table.    */
+  asm volatile ("mov %%cr3, %0" : "=r" (firmware_cr3));
+  grub_memcpy (pt4, (void *) (firmware_cr3 & ~0xfffULL), GRUB_PAGE_SIZE);
   *(grub_uint32_t *) p = (grub_uint8_t *) endpreamble - p - 4;
 
   for (i = 0; i < npt3pages; i++)
